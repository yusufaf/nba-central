{
    // https://github.com/vuejs/tsconfig/blob/main/tsconfig.json
    // These options are inlined rather than inherited from
    // @vue/tsconfig/tsconfig.dom.json. The original reason is obsolete: that
    // package used to be pinned to 0.1.x, whose base set the since-removed
    // `importsNotUsedAsValues`/`preserveValueImports` (TS5102), which an
    // `extends` cannot unset. It now resolves to 0.9.1 and no longer sets
    // them, so extending it (as tsconfig.app.json already does) would work and
    // would drop most of the duplication below. Left inlined for now — the
    // switch changes `lib` (ES2022 vs ESNext) and adds `jsxImportSource`,
    // `moduleDetection: force` and `allowImportingTsExtensions`, so it wants
    // its own verification pass.
    "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "useDefineForClassFields": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": [],
        // `"noImplicitThis": true` is part of `strict`
        // Added again here in case some users decide to disable `strict`.
        // This enables stricter inference for data properties on `this`.
        "noImplicitThis": true,
        "strict": true,
        // Recommended
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        // See <https://github.com/vuejs/vue-cli/pull/5688>
        "skipLibCheck": true,
        "noImplicitAny": false,
        // No `baseUrl`: deprecated in TS 6 (TS5101). `paths` patterns resolve
        // relative to this file's directory without it.
        "paths": {
            "@/*": ["./src/*"],
        },
        "jsx": "preserve",
    },
}
