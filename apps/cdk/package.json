{
    "name": "@team-builder/cdk",
    "version": "0.1.0",
    "packageManager": "pnpm@10.24.0",
    "bin": {
        "cdk": "bin/cdk.js"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test:coverage": "vitest run --coverage",
        "refresh-arenas": "ts-node -r tsconfig-paths/register scripts/refresh-arenas.ts",
        "refresh-coaches": "ts-node -r tsconfig-paths/register scripts/refresh-coaches.ts",
        "refresh-execs": "ts-node -r tsconfig-paths/register scripts/refresh-execs.ts",
        "refresh-historical-logos": "ts-node -r tsconfig-paths/register scripts/refresh-historical-logos.ts",
        "rekey-historical-logos": "ts-node -r tsconfig-paths/register scripts/rekey-historical-logos.ts",
        "cdk": "cdk"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.540.0",
        "@aws-sdk/client-lambda": "^3.540.0",
        "@aws-sdk/client-s3": "^3.540.0",
        "@aws-sdk/client-ses": "^3.556.0",
        "@aws-sdk/lib-dynamodb": "^3.540.0",
        "@aws-sdk/s3-request-presigner": "^3.540.0",
        "aws-cdk-lib": "^2.254.0",
        "cheerio": "1.0.0-rc.12",
        "constructs": "^10.6.0",
        "dotenv": "^16.4.5",
        "fast-xml-parser": "^5.10.1",
        "jose": "^6.2.9",
        "jsdom": "^24.0.0",
        "node-fetch": "^3.3.2",
        "source-map-support": "^0.5.21"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/aws-lambda": "^8.10.136",
        "@types/jsdom": "^21.1.6",
        "@types/node": "^20.12.2",
        "@vitest/coverage-v8": "4.1.11",
        "aws-cdk": "^2.1122.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.9.1",
        "globals": "^17.12.0",
        "prettier": "3.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.69.0",
        "vitest": "4.1.11"
    }
}
