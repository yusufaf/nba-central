{
  "name": "team-builder",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "type-check": "pnpm --filter web type-check",
    "check:styles": "pnpm --filter web check:styles",
    "lint": "pnpm -r lint",
    "synth": "pnpm --filter cdk exec cdk synth --quiet",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "^1.8.4",
      "lodash": "^4.18.0",
      "ws": "^8.21.0",
      "defu": "^6.1.7",
      "flatted": "^3.4.2",
      "js-yaml": "^4.3.2",
      "postcss": "^8.5.26",
      "picomatch": "^4.0.5",
      "form-data": "^4.0.6",
      "minimatch": "^10.2.5",
      "undici": "^7.29.0",
      "diff": "^8.0.4",
      "fast-uri": "^3.1.6",
      "nanoid": "^3.3.18",
      "esbuild": "^0.28.2"
    }
  }
}
