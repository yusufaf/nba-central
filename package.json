{
    "name": "team-builder-cdk",
    "version": "0.1.0",
    "packageManager": "pnpm@10.24.0",
    "bin": {
        "cdk": "bin/cdk.js"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "refresh-arenas": "ts-node -r tsconfig-paths/register scripts/refresh-arenas.ts",
        "refresh-coaches": "ts-node -r tsconfig-paths/register scripts/refresh-coaches.ts",
        "refresh-execs": "ts-node -r tsconfig-paths/register scripts/refresh-execs.ts",
        "refresh-historical-logos": "ts-node -r tsconfig-paths/register scripts/refresh-historical-logos.ts",
        "rekey-historical-logos": "ts-node -r tsconfig-paths/register scripts/rekey-historical-logos.ts",
        "cdk": "cdk",
        "prepare": "husky"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.540.0",
        "@aws-sdk/client-lambda": "^3.540.0",
        "@aws-sdk/client-s3": "^3.540.0",
        "@aws-sdk/client-ses": "^3.556.0",
        "@aws-sdk/lib-dynamodb": "^3.540.0",
        "@aws-sdk/s3-request-presigner": "^3.540.0",
        "aws-cdk-lib": "^2.254.0",
        "cheerio": "1.0.0-rc.12",
        "constructs": "^10.6.0",
        "dotenv": "^16.4.5",
        "fast-xml-parser": "^5.10.1",
        "jose": "^6.2.9",
        "jsdom": "^24.0.0",
        "node-fetch": "^3.3.2",
        "source-map-support": "^0.5.21"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/js": "^9.33.0",
        "@types/aws-lambda": "^8.10.136",
        "@types/jsdom": "^21.1.6",
        "@types/node": "^20.12.2",
        "@vitest/coverage-v8": "2.1.9",
        "aws-cdk": "^2.1122.0",
        "esbuild": "^0.20.2",
        "eslint": "^9.33.0",
        "globals": "^16.3.0",
        "husky": "^9.1.7",
        "prettier": "3.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.39.1",
        "vitest": "2.1.9"
    },
    "pnpm": {
        "overrides": {
            "ws": "^8.21.0",
            "js-yaml": "4.3.0",
            "flatted": "3.4.2",
            "form-data": "^4.0.6",
            "fast-uri": "3.1.4"
        }
    }
}
