{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>yusufaf/renovate-config"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "apps/cdk/resources/lambda/layers/**"
  ],
  "packageRules": [
    {
      "description": "CDK bumps change deployed infrastructure",
      "matchPackageNames": ["aws-cdk", "aws-cdk-lib", "constructs", "@aws-cdk/**"],
      "groupName": "aws-cdk",
      "automerge": false
    }
  ]
}
